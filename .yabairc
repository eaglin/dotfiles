#!/usr/bin/env sh

# Predictable default: every Space starts tiled and can be changed from skhd.
yabai -m config \
  layout bsp \
  split_type auto \
  window_placement second_child \
  auto_balance off \
  window_gap 10 \
  top_padding 0 \
  bottom_padding 10 \
  left_padding 10 \
  right_padding 10 \
  external_bar all:40:0 \
  focus_follows_mouse off \
  mouse_follows_focus off \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

# Highlight the focused window.
killall borders >/dev/null 2>&1
borders \
  active_color=0xff00d9ff \
  inactive_color=0xff26233a \
  width=5.0 \
  hidpi=on \
  ax_focus=on \
  blacklist="System Settings,Karabiner-Elements" &

# Browsers and general apps.
yabai -m rule --add app="^Zen$" space=1
yabai -m rule --add app="^Google Chrome$" space=1
yabai -m rule --add app="^Notes$" space=1 manage=off

# Development.
yabai -m rule --add app="^Ghostty$" space=2
yabai -m rule --add app="^IntelliJ IDEA" space=3

# Content creation.
yabai -m rule --add app="^OBS Studio$" space=4 manage=off
yabai -m rule --add app="^ClipGrab$" space=4 manage=off
yabai -m rule --add app="^CapCut$" space=5 manage=off
yabai -m rule --add app="^DaVinci Resolve$" space=6 manage=off

# Communication and infrastructure.
yabai -m rule --add app="^Docker Desktop$" space=8 manage=off
yabai -m rule --add app="^Microsoft Teams$" space=7 manage=off
# WhatsApp's accessibility name can contain an invisible prefix.
yabai -m rule --add app="WhatsApp$" space=7 manage=off

# Utility windows should stay under macOS control.
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^(System Settings|Ajustes del Sistema)$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off

# Keep SketchyBar synchronized. Native focus handling is left to yabai/macOS.
yabai -m signal --add label=sketchybar_space_changed event=space_changed action="sketchybar --trigger yabai_space_change"
yabai -m signal --add label=sketchybar_window_created event=window_created action="sketchybar --trigger yabai_space_change"
yabai -m signal --add label=sketchybar_window_destroyed event=window_destroyed action="sketchybar --trigger yabai_space_change"
yabai -m signal --add label=sketchybar_window_focused event=window_focused action="sketchybar --trigger yabai_space_change"

sketchybar --reload >/dev/null 2>&1 &
