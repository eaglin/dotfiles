#!/usr/bin/env sh

# Global fallback; role-specific Spaces override this below.
yabai -m config \
  layout bsp \
  window_placement second_child \
  window_gap 10 \
  top_padding 10 \
  bottom_padding 10 \
  left_padding 10 \
  right_padding 10 \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

# Per-Space default layouts.
yabai -m config --space 2 layout float
yabai -m config --space 3 layout float
yabai -m config --space 4 layout float
yabai -m config --space 5 layout stack

# Highlight the focused window (JankyBorders — required because
# native yabai borders need the scripting addition / SIP disabled).
killall borders >/dev/null 2>&1
borders \
  active_color=0xff00d9ff \
  inactive_color=0xff26233a \
  width=5.0 \
  hidpi=on \
  ax_focus=on \
  blacklist="System Settings,Karabiner-Elements" &

# Browsers.
yabai -m rule --add app="^Zen$" space=1
yabai -m rule --add app="^Google Chrome$" space=1

# Development.
yabai -m rule --add app="^Ghostty$" space=2
yabai -m rule --add app="^IntelliJ IDEA" space=3
yabai -m rule --add label=development-xcode app="^Xcode$" space=3

# Content creation.
yabai -m rule --add label=media-obs app="^OBS( Studio)?$" space=4 manage=off
yabai -m rule --add label=media-clipgrab app="^ClipGrab$" space=4 manage=off
yabai -m rule --add label=media-capcut app="^CapCut$" space=4 manage=off
yabai -m rule --add label=media-davinci app="^DaVinci Resolve$" space=4 manage=off
yabai -m rule --add label=media-blackmagic app="^Blackmagic " space=4 manage=off

# Communication, productivity, and infrastructure apps share the stack on Space 5.
yabai -m rule --add label=productivity-notes app="^Notes$" space=5
yabai -m rule --add label=productivity-word app="^Microsoft Word$" space=5
yabai -m rule --add label=productivity-excel app="^Microsoft Excel$" space=5
yabai -m rule --add label=communication-outlook app="^Microsoft Outlook$" space=5
yabai -m rule --add label=communication-teams app="^Microsoft Teams" space=5
# WhatsApp's accessibility name can contain an invisible prefix.
yabai -m rule --add label=communication-whatsapp app="WhatsApp$" space=5
yabai -m rule --add label=infrastructure-docker app="^Docker Desktop$" space=5

# Utility windows should stay under macOS control.
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^(System Settings|Ajustes del Sistema)$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off

# Focus the first window when entering a space.
yabai -m signal --add event=space_changed action="yabai -m window --focus first 2>/dev/null"

# SketchyBar integration (disabled — install sketchybar to enable).
# yabai -m signal --add label=sketchybar_window_created event=window_created action="sketchybar --trigger yabai_space_change"
# yabai -m signal --add label=sketchybar_window_destroyed event=window_destroyed action="sketchybar --trigger yabai_space_change"
# sketchybar --reload >/dev/null 2>&1 &
