source "$CONFIG_DIR/items/clock.sh"

source "$CONFIG_DIR/items/battery.sh"
source "$CONFIG_DIR/items/volume.sh"
source "$CONFIG_DIR/items/bluetooth.sh"
source "$CONFIG_DIR/items/wifi.sh"
# source "$CONFIG_DIR/items/network.sh"

sketchybar -m --add item spacer right \
  --set spacer \
  margin=0 \
  label.padding_right=10 \
  label.padding_left=10 \
  icon.drawing=off \
  label=""
sketchybar --add bracket status battery volume wifi bt \
  --set status \
  background.corner_radius=4 \
  background.height=20

source "$CONFIG_DIR/items/system-data.sh"

sketchybar --add bracket spaces space_left_spaces space.1 space.2 space.3 space.4 space.5 space_right_spaces \
  --set spaces \
  background.color=$SURFACE0 \
  background.height=24 \
  background.border_color=$CRUST \
  background.border_width=1 \
  background.corner_radius=6
##### Force all scripts to run the first time (never do this in a script) #####

sketchybar --add bracket system memory disk cpu \
  --set system \
  background.drawing=on \
  background.color=$SURFACE0 \
  background.corner_radius=6 \
  background.border_color=$CRUST \
  background.border_width=1 \
  background.height=24

sketchybar --update
sketchybar --hotload true
