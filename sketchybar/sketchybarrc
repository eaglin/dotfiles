#!/bin/bash

# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles
source "$HOME/.config/sketchybar/icons.sh" # Loads all defined colors
CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
ITEMS_DIR="$CONFIG_DIR/items"
FONT="JetBrains Mono"
source "$CONFIG_DIR/colors-catppuccin.sh" # Loads all defined colors

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker
bar=(
  position=top
  height=32
  color=$BASE_TRANSPARENT
  padding_left=10
  padding_right=20

)

sketchybar --bar "${bar[@]}"
##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_right=5
  icon.font="Hack Nerd Font:Bold:13.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=$TEXT
  label.color=$TEXT
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
  background.height=28
  popup.background.corner_radius=6
  popup.background.color=$SURFACE0
  popup.background.border_color=$SURFACE2
  popup.background.border_width=2
)
sketchybar --default "${default[@]}"

#####AEROSPACE#####

sketchybar -m --add item spacer_power_left left \
  --set spacer_power_left \
  icon.padding_left=0 \
  icon.padding_right=0 \
  label=""

source "$CONFIG_DIR/items/power_menu.sh"

sketchybar -m --add item spacer_power left \
  --set spacer_power \
  label.padding_left=0 \
  label.padding_right=0 \
  icon.padding_left=0 \
  icon.padding_right=0 \
  label=""

sketchybar -m --add item space_left_spaces left \
  --set space_left_spaces \
  background.drawing=on \
  label.padding_right=0 \
  label="" \
  label.padding_left=0

source "$CONFIG_DIR/items/aerospaces.sh"

sketchybar --add item space_right_spaces left \
  --set space_right_spaces \
  label.padding_right=0 \
  icon.drawing=off

source "$CONFIG_DIR/items/front_app.sh"
